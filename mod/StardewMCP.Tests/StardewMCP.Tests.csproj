<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-free unit tests. This project must NOT reference ../StardewMCP/StardewMCP.csproj: that one needs
    the Stardew Valley and SMAPI assemblies (Pathoschild.Stardew.ModBuildConfig finds them in your game
    folder), which CI and most dev machines don't have. Instead the files of the mod that use no game types
    are compiled straight into this project below. Prefer game-free logic. The diagnostic bridge is also
    compiled against minimal test-only screen shims; this does not establish real game API compatibility.

    Run:  dotnet test mod/StardewMCP.Tests
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>StardewMCP.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The mod targets net6.0 like the game; let the tests run on a newer installed runtime too. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <!-- Game-free sources plus the diagnostic bridge compiled against minimal test-only screen shims. -->
  <ItemGroup>
    <Compile Include="..\StardewMCP\Agent\DiagnosticStatus.cs" Link="Mod\DiagnosticStatus.cs" />
    <Compile Include="..\StardewMCP\Agent\DiagnosticEvidenceSampler.cs" Link="Mod\DiagnosticEvidenceSampler.cs" />
    <Compile Include="..\StardewMCP\Agent\DiagnosticEvidence.cs" Link="Mod\DiagnosticEvidence.cs" />
    <Compile Include="..\StardewMCP\PathSearch.cs" Link="Mod\PathSearch.cs" />
    <Compile Include="..\StardewMCP\Agent\ToolDef.cs" Link="Mod\ToolDef.cs" />
    <Compile Include="..\StardewMCP\Agent\ToolArgs.cs" Link="Mod\ToolArgs.cs" />
    <Compile Include="..\StardewMCP\Agent\ToolContract.cs" Link="Mod\ToolContract.cs" />
    <Compile Include="..\StardewMCP\Agent\LoopDetector.cs" Link="Mod\LoopDetector.cs" />
    <Compile Include="..\StardewMCP\Agent\McpDispatcher.cs" Link="Mod\McpDispatcher.cs" />
    <Compile Include="..\StardewMCP\Agent\Peek.cs" Link="Mod\Peek.cs" />
    <Compile Include="..\StardewMCP\Agent\KnowledgeMath.cs" Link="Mod\KnowledgeMath.cs" />
    <Compile Include="..\StardewMCP\Agent\BobberController.cs" Link="Mod\BobberController.cs" />
    <Compile Include="..\StardewMCP\Agent\WorldText.Format.cs" Link="Mod\WorldText.Format.cs" />
    <Compile Include="..\StardewMCP\Agent\BubbleText.cs" Link="Mod\BubbleText.cs" />
    <Compile Include="..\StardewMCP\Agent\SpeechQueue.cs" Link="Mod\SpeechQueue.cs" />
    <Compile Include="..\StardewMCP\Agent\WalkMath.cs" Link="Mod\WalkMath.cs" />
    <Compile Include="..\StardewMCP\Agent\SightLog.cs" Link="Mod\SightLog.cs" />
    <Compile Include="..\StardewMCP\Agent\StaleMessage.cs" Link="Mod\StaleMessage.cs" />
    <Compile Include="..\StardewMCP\Agent\Brain\Llm.cs" Link="Mod\Brain\Llm.cs" />
    <Compile Include="..\StardewMCP\Agent\Brain\AnthropicProvider.cs" Link="Mod\Brain\AnthropicProvider.cs" />
    <Compile Include="..\StardewMCP\Agent\Brain\OpenAiProvider.cs" Link="Mod\Brain\OpenAiProvider.cs" />
    <Compile Include="..\StardewMCP\Agent\Brain\GeminiProvider.cs" Link="Mod\Brain\GeminiProvider.cs" />
    <Compile Include="..\StardewMCP\Agent\Brain\Prompts.cs" Link="Mod\Brain\Prompts.cs" />
  </ItemGroup>

</Project>

